# SENTINEL-X ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in real values

# === APPLICATION ===
NEXT_PUBLIC_APP_NAME="SENTINEL-X"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_ENVIRONMENT="production"

# === AI ANALYSIS ENGINE ===
# OpenAI API key for forensic anomaly detection
OPENAI_API_KEY="sk-..."

# === DATABASE (future) ===
DATABASE_URL="postgresql://user:password@localhost:5432/sentinelx"

# === REDIS (session / rate limiting) ===
REDIS_URL="redis://localhost:6379"

# === AUTHENTICATION ===
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# === NETWORK SCANNER ===
SCAN_TIMEOUT_MS="5000"
MAX_CONCURRENT_SCANS="10"

# === AUDIT LOGS ===
AUDIT_RETENTION_DAYS="365"
AUDIT_MAX_ENTRIES="100000"

# === WEBHOOK / ALERTING ===
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
PAGERDUTY_KEY="..."
